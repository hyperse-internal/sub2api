# ai.alphaio.vip → Sub2API（127.0.0.1:8080）+ docs website（127.0.0.1:3001）
# 安装到 /etc/nginx/sites-available/ai.alphaio.vip 后链到 sites-enabled

upstream sub2api_backend {
  server 127.0.0.1:8080;
  keepalive 32;
}

# website/ SSR（PM2：react-router-serve），仅本机访问
upstream alphaio_docs {
  server 127.0.0.1:3001;
  keepalive 8;
}

server {
  listen 80;
  listen [::]:80;
  server_name ai.alphaio.vip;

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name ai.alphaio.vip;

  ssl_certificate     /data/alphaio/apps/hps-quants-backend/packages/main/docs/ssl/www_alphaio_vip.crt;
  ssl_certificate_key /data/alphaio/apps/hps-quants-backend/packages/main/docs/ssl/www_alphaio_vip.key;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  # Codex 粘性会话依赖带下划线的请求头（如 session_id）
  underscores_in_headers on;

  client_max_body_size 256m;

  access_log /var/log/nginx/ai.alphaio.vip.access.log;
  error_log  /var/log/nginx/ai.alphaio.vip.error.log;

  # —— docs website（须写在 location / 之前）——
  # 营销首页在 /tools（勿用 /，与 Go 面板冲突）
  location ^~ /tools {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://alphaio_docs;
    proxy_redirect off;
  }

  location ^~ /cn/tools {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://alphaio_docs;
    proxy_redirect off;
  }

  location ^~ /docs-assets/ {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://alphaio_docs;
    proxy_redirect off;
  }

  location ^~ /docs-api/ {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://alphaio_docs;
    proxy_redirect off;
  }

  location ^~ /docs {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://alphaio_docs;
    proxy_redirect off;
  }

  location ^~ /cn/docs {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://alphaio_docs;
    proxy_redirect off;
  }

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Host $host:$server_port;
    proxy_set_header X-Forwarded-Server $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "";
    proxy_pass http://sub2api_backend;
    proxy_redirect off;

    proxy_buffering off;
    proxy_cache off;
    proxy_request_buffering off;
    chunked_transfer_encoding on;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    send_timeout 3600s;
  }

  location = /health {
    proxy_pass http://sub2api_backend/health;
    access_log off;
  }
}
