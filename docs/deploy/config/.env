# ===== Sub2API 生产配置 =====
# 固定配置、.installed、应用日志目录；不设时程序会优先用 /app/data
DATA_DIR=/opt/sub2api
# 日志只写有轮转的 logs/sub2api.log；systemd 的 stdout.log 不轮转
LOG_OUTPUT_TO_STDOUT=false

# --- 数据库 (PostgreSQL) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=hps
DATABASE_PASSWORD=hps
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1

# --- 服务 ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_MODE=release
TZ=Asia/Shanghai

# --- 管理员 ---
ADMIN_EMAIL=admin@alphaio.vip
ADMIN_PASSWORD=fXEv10fk7qtuXU2SpA9J

# --- 密钥（本地/外部真实熵生成，规避观测假象）---
JWT_SECRET=7207ce163fd79cbc7dc1a35afa62e4b176ba54e1cd928a4a186a6f369d6d5d6b
TOTP_ENCRYPTION_KEY=acc49c3b582bca3da101fecae25f40b34ca39d4c43cb314152f7a14bd0177d26